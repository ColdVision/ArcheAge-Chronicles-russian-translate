<Window x:Class="X5Translator.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="X5 Translator — перевод ArcheAge Chronicles" Width="1250" Height="760" MinWidth="900" MinHeight="500"
        WindowStartupLocation="CenterScreen">
    <DockPanel Margin="8">
        <StatusBar DockPanel.Dock="Bottom">
            <StatusBarItem><TextBlock x:Name="StatusText" Text="Откройте оригинальный String.locres (en) или проект."/></StatusBarItem>
            <StatusBarItem HorizontalAlignment="Right"><TextBlock x:Name="CountText"/></StatusBarItem>
        </StatusBar>

        <WrapPanel DockPanel.Dock="Top">
            <Button x:Name="BtnOpenBase" Content="Открыть оригинал (.locres)…" Click="BtnOpenBase_Click"/>
            <Button x:Name="BtnMerge" Content="Подгрузить готовый перевод…" Click="BtnMerge_Click" IsEnabled="False"/>
            <Button Content="Открыть проект…" Click="BtnOpenProject_Click"/>
            <Button x:Name="BtnSave" Content="Сохранить проект" Click="BtnSave_Click" IsEnabled="False"/>
            <Button x:Name="BtnImportCsv" Content="Импорт CSV…" Click="BtnImportCsv_Click" IsEnabled="False"/>
            <Button x:Name="BtnExportCsv" Content="Экспорт CSV…" Click="BtnExportCsv_Click" IsEnabled="False"/>
            <Button x:Name="BtnBuild" Content="Сохранить String.locres…" Click="BtnBuild_Click" IsEnabled="False"/>
        </WrapPanel>

        <Grid DockPanel.Dock="Top" Margin="0,2,0,6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="280"/>
                <ColumnDefinition Width="170"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBox x:Name="FilterBox" Grid.Column="0" Height="26" VerticalContentAlignment="Center" TextChanged="Filter_Changed" ToolTip="Поиск по ключу, оригиналу и переводу"/>
            <ComboBox x:Name="FilterMode" Grid.Column="1" Height="26" Margin="6,0,0,0" SelectedIndex="0" SelectionChanged="Filter_Changed">
                <ComboBoxItem Content="Все"/>
                <ComboBoxItem Content="Непереведённые"/>
                <ComboBoxItem Content="Переведённые"/>
                <ComboBoxItem Content="С предупреждениями"/>
            </ComboBox>
            <TextBox x:Name="GameDirBox" Grid.Column="2" Height="26" Margin="14,0,6,0" VerticalContentAlignment="Center" ToolTip="Папка игры (рядом с ArcheAgeChronicles.exe)"/>
            <Button Grid.Column="3" Content="Обзор…" Margin="0" Click="BtnBrowseGame_Click"/>
            <Button x:Name="BtnInstall" Grid.Column="4" Content="Установить в игру" Margin="6,0,0,0" Click="BtnInstall_Click" IsEnabled="False"/>
            <Button x:Name="BtnUninstall" Grid.Column="5" Content="Убрать из игры" Margin="6,0,0,0" Click="BtnUninstall_Click"/>
        </Grid>

        <DataGrid x:Name="Grid" AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False"
                  EnableRowVirtualization="True" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                  SelectionUnit="FullRow" GridLinesVisibility="Horizontal" HeadersVisibility="Column"
                  CellEditEnding="Grid_CellEditEnding">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Namespace" Binding="{Binding Namespace}" IsReadOnly="True" Width="110"/>
                <DataGridTextColumn Header="Ключ" Binding="{Binding Key}" IsReadOnly="True" Width="190"/>
                <DataGridTextColumn Header="Оригинал" Binding="{Binding Original}" IsReadOnly="True" Width="*">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock"><Setter Property="TextWrapping" Value="Wrap"/><Setter Property="Margin" Value="3"/></Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
                <DataGridTextColumn Header="Перевод" Binding="{Binding Translation, UpdateSourceTrigger=LostFocus}" Width="*">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock"><Setter Property="TextWrapping" Value="Wrap"/><Setter Property="Margin" Value="3"/></Style>
                    </DataGridTextColumn.ElementStyle>
                    <DataGridTextColumn.EditingElementStyle>
                        <Style TargetType="TextBox"><Setter Property="TextWrapping" Value="Wrap"/><Setter Property="AcceptsReturn" Value="True"/></Style>
                    </DataGridTextColumn.EditingElementStyle>
                </DataGridTextColumn>
                <DataGridTextColumn Header="!" Binding="{Binding WarnMark}" IsReadOnly="True" Width="30">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="ToolTip" Value="{Binding Warning}"/>
                            <Setter Property="Foreground" Value="#C0392B"/>
                            <Setter Property="FontWeight" Value="Bold"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
            </DataGrid.Columns>
        </DataGrid>
    </DockPanel>
</Window>
